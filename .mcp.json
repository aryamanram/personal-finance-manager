{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--headless", "--isolated",
               "--allowed-origins", "http://127.0.0.1:3001;http://localhost:3001;http://127.0.0.1:6006;http://localhost:6006"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@0.4.0"],
      "env": { "NEXT_TELEMETRY_DISABLED": "1" }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1", "--headless", "--isolated", "--usageStatistics=false",
               "--blockedUrlPattern", "http://127.0.0.1:3000/*",
               "--blockedUrlPattern", "http://localhost:3000/*"],
      "env": { "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1" }
    }
  }
}
