# Copy to .env.local and fill in. NEVER commit .env.local.

# Local Postgres (docker compose up -d)
DATABASE_URL=postgres://finance:finance_dev_local@localhost:5433/finance

# SimpleFIN. Exchange your one-time setup token for an access URL:
#   https://beta-bridge.simplefin.org/
# This is a BEARER CREDENTIAL IN URL FORM. Never log it, never commit it.
SIMPLEFIN_ACCESS_URL=

# Anthropic API key for LLM categorization fallback (Claude Haiku).
# Optional: without it the categorizer skips step 3 and leaves rows Uncategorized.
ANTHROPIC_API_KEY=
