# ---------------------------------------------------------------------------
# SECRETS AND PERSONAL FINANCIAL DATA
# This repo is public-facing. Nothing below may ever be committed.
# ---------------------------------------------------------------------------

# Env / credentials. SIMPLEFIN_ACCESS_URL is a bearer credential in URL form.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Real statements, exports, and any downloaded financial file.
/data/
/private/
*.csv
*.ofx
*.qfx
*.qbo
*.pdf

# Synthetic fixtures are the ONLY tracked CSVs, and they are listed by name
# rather than unignoring the whole directory. A blanket `!fixtures/**/*.csv`
# means dropping a real statement into fixtures/ commits it silently — which is
# exactly the mistake someone makes while debugging an import.
# Adding a fixture is therefore a deliberate act: add its name here too.
!fixtures/applecard-negative.csv
!fixtures/applecard-positive.csv

# Database dumps and local volumes
*.sql.gz
*.dump
*.bak
db/dumps/
pgdata/
postgres-data/

# ---------------------------------------------------------------------------
# Build / tooling
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Drizzle introspection output is regenerated from db/schema.sql
db/drizzle/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
